---
import { PROJECTS } from '../../constants'
import Section from '../ui/Section.astro'
import Container from '../ui/Container.astro'
import SectionHeader from '../ui/SectionHeader.astro'

const gradients = [
  'from-primary/30 via-secondary/20 to-accent/20',
  'from-accent/30 via-primary/20 to-accent-soft/20',
  'from-accent-soft/30 via-accent-warm/20 to-primary/20',
  'from-secondary/30 via-accent/20 to-primary/20',
]
---

<Section id="proyectos" ariaLabelledby="projects-title" background="surface">
  <Container>
    <SectionHeader
      label="Proyectos"
      title="Trabajos recientes"
      description="Proyectos reales con código limpio, diseño cuidado y resultados medibles."
      id="projects-title"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {PROJECTS.map((project, i) => (
        <article
          class="group bg-card border border-border rounded-[--radius-lg] overflow-hidden transition-all duration-[0.3s] hover:-translate-y-[2px] hover:border-primary/20 hover:shadow-[0_8px_24px_-8px_rgba(99,102,241,0.12)] fade-up flex flex-col"
        >
          <div class={`aspect-[4/3] bg-gradient-to-br ${gradients[i % gradients.length]} relative overflow-hidden`}>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-11 h-11 rounded-full bg-white/10 backdrop-blur-[4px] flex items-center justify-center group-hover:scale-110 transition-transform duration-[0.3s]">
                <svg class="w-5 h-5 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-card/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[0.3s]" />
          </div>
          <div class="p-4 flex flex-col flex-1">
            <h3 class="text-[0.85rem] font-bold text-text-primary mb-1 group-hover:text-primary transition-colors duration-[0.22s]">
              {project.title}
            </h3>
            <p class="text-[0.75rem] text-text-secondary leading-[1.55] mb-2.5 flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-1 mb-2.5">
              {project.tags.map((tag) => (
                <span class="text-[0.55rem] font-medium px-1.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 text-primary-light">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex gap-2.5">
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[0.65rem] font-semibold text-primary hover:text-primary-light transition-colors duration-[0.22s] flex items-center gap-1"
                >
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Demo
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </Container>
</Section>
