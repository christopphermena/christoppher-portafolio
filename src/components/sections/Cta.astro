---
import { SITE } from '../../constants'
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
---

<section id="contacto" aria-labelledby="cta-title" class="py-16 md:py-20 bg-base relative overflow-hidden">
  <div class="blob w-[500px] h-[500px] bg-primary/10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
  <div class="blob w-[300px] h-[300px] bg-accent-soft/8 top-0 right-0"></div>
  <div class="blob w-[300px] h-[300px] bg-accent/8 bottom-0 left-0"></div>
  <Container>
    <div class="relative z-10 text-center bg-card border border-border rounded-[--radius-xl] px-8 py-12 md:py-16 max-w-[680px] mx-auto shadow-[0_20px_60px_-16px_rgba(0,0,0,0.3)] fade-up">
      <p class="text-xs font-semibold tracking-[0.16em] uppercase text-primary mb-4">🤝 Trabajemos juntos</p>
      <h2 id="cta-title" class="text-[clamp(2rem,4.5vw,3.2rem)] font-black leading-[1.1] tracking-[-0.025em] text-text-primary mb-4">
        ¿Listo para llevar tu idea<br />
        <span class="gradient-text">al siguiente nivel?</span>
      </h2>
      <p class="text-text-secondary text-lg leading-[1.7] mb-8 max-w-[480px] mx-auto">
        Cuéntame tu proyecto y te enviaré una propuesta clara sin compromiso. Sin vueltas, solo trabajo bien hecho.
      </p>
      <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
        <Button href={`mailto:${SITE.email}`} variant="primary" size="lg" ariaLabel="Enviar un correo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Enviar correo
        </Button>
        <Button href={SITE.social.linkedin || '#'} variant="secondary" size="lg" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </Button>
      </div>
      <p class="text-[0.75rem] text-text-muted mt-4">Respuesta en menos de 24 horas</p>
    </div>
  </Container>
</section>
